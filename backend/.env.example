# Governance Desk API configuration. Copy to backend/.env (or set real environment variables).
# Never commit real values. Every setting below is optional in development.

# ---- Environment profile -------------------------------------------------------------------
# development (default) | test | staging | production
#   development: local-preview sign-in, API docs, migrations applied on start
#   test:        like development, but GOVERNANCE_DATA_DIR must be set explicitly
#   staging/production: refuse to start with local-preview sign-in or missing settings below
# GOVERNANCE_ENVIRONMENT=development

# ---- Data ------------------------------------------------------------------------------------
# SQLite database (preview.sqlite) and uploaded files (files/).
# Development default: ../.sites-runtime/preview (the existing local workspace).
# Required in test/staging/production; must be OUTSIDE the source tree in staging/production.
# GOVERNANCE_DATA_DIR=/var/lib/governance-desk

# Built React app served by the API (`pnpm frontend:build`).
# GOVERNANCE_FRONTEND_DIR=

# ---- Network -------------------------------------------------------------------------------
# Bind address used by `python -m app`. Requests must use Host 127.0.0.1:<port> or a host below.
# HOST=127.0.0.1
# PORT=5174
# Extra accepted Host headers, comma separated. Required in staging/production (public host names).
# GOVERNANCE_ALLOWED_HOSTS=desk.example.com

# ---- Authentication (Phase 1: local preview only) ------------------------------------------
# local-preview signs the browser in as the workspace owner; it is rejected in staging/production.
# Any other value disables the local sign-in (every API request returns 401).
# GOVERNANCE_AUTH_MODE=local-preview
# GOVERNANCE_SESSION_HOURS=12

# ---- Behaviour switches (unset = environment default) --------------------------------------
# GOVERNANCE_API_DOCS=        # /api/docs + /api/openapi.json; default on in development/test only
# GOVERNANCE_AUTO_MIGRATE=    # apply migrations on start; default on in development/test only
# GOVERNANCE_HSTS=            # Strict-Transport-Security; default on in staging/production
# GOVERNANCE_CSP=             # full Content-Security-Policy override; empty = built-in policy
# GOVERNANCE_REMINDERS_ENABLED=true
# GOVERNANCE_REMINDER_INTERVAL_SECONDS=60

# ---- Logging -------------------------------------------------------------------------------
# GOVERNANCE_LOG_LEVEL=INFO
# GOVERNANCE_LOG_FORMAT=json  # json (default) | text

# ---- Optional external services (empty = not configured). Secrets are masked in logs. --------
OPENAI_API_KEY=
OPENAI_MODEL=
RESEND_API_KEY=
MAIL_FROM=
