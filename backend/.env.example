# Governance Desk API configuration. Copy to backend/.env (or set real environment variables).
# Never commit real values. Every setting below is optional in development.

# ---- Environment profile -------------------------------------------------------------------
# development (default) | test | staging | production
#   development: local-preview sign-in, API docs, migrations applied on start
#   test:        like development, but GOVERNANCE_DATA_DIR must be set explicitly
#   staging/production: refuse to start with local-preview sign-in or missing settings below
# GOVERNANCE_ENVIRONMENT=development

# ---- Database --------------------------------------------------------------------------------
# Empty = the SQLite file <data dir>/preview.sqlite (development and tests).
# Required in staging/production: PostgreSQL (see docs/POSTGRESQL.md). Secret: never commit it.
# GOVERNANCE_DATABASE_URL=postgresql+psycopg://governance:CHANGE-ME@db.internal:5432/governance
# GOVERNANCE_DB_POOL_SIZE=5
# GOVERNANCE_DB_MAX_OVERFLOW=5
# GOVERNANCE_DB_POOL_TIMEOUT=10
# GOVERNANCE_DB_POOL_RECYCLE=1800
# GOVERNANCE_DB_STATEMENT_TIMEOUT_MS=30000
# GOVERNANCE_DB_LOCK_TIMEOUT_MS=10000

# ---- Data ------------------------------------------------------------------------------------
# SQLite database (preview.sqlite, when no database URL is set) and uploaded files (files/).
# Development default: ../.sites-runtime/preview (the existing local workspace).
# Required in test/staging/production; must be OUTSIDE the source tree in staging/production.
# GOVERNANCE_DATA_DIR=/var/lib/governance-desk

# Built React app served by the API (`pnpm frontend:build`).
# GOVERNANCE_FRONTEND_DIR=

# ---- Network -------------------------------------------------------------------------------
# Bind address used by `python -m app`. Requests must use Host 127.0.0.1:<port> or a host below.
# HOST=127.0.0.1
# PORT=5174
# Extra accepted Host headers, comma separated. Required in staging/production (public host names).
# GOVERNANCE_ALLOWED_HOSTS=desk.example.com

# ---- Authentication --------------------------------------------------------------------------
# local-preview (development/test only): opening the app signs the browser in as the workspace
#   owner and "Preview as" switches profile. Rejected in staging/production.
# password: built-in email + password sign-in (argon2id), invitations, password reset.
#   Bootstrap the first owner with: python -m app.cli create-organization ... (see docs/AUTHENTICATION.md)
# GOVERNANCE_AUTH_MODE=local-preview
# Organization the development preview signs in to (created on first start in development/test).
# GOVERNANCE_WORKSPACE_ID=local-preview
# GOVERNANCE_SESSION_HOURS=12              # absolute session lifetime
# GOVERNANCE_SESSION_IDLE_MINUTES=30       # password sessions end after this much inactivity
# GOVERNANCE_LOGIN_MAX_FAILURES=5          # per account, within the window below
# GOVERNANCE_LOGIN_MAX_FAILURES_PER_CLIENT=30
# GOVERNANCE_LOGIN_WINDOW_MINUTES=15
# GOVERNANCE_ACTIVATION_HOURS=72           # invitation link lifetime
# GOVERNANCE_RESET_MINUTES=30              # password reset link lifetime
# Number of reverse proxies you run in front of the app (they append to X-Forwarded-For).
# 0 = use the socket address. Never set this higher than the proxies you control.
# GOVERNANCE_FORWARDED_HOPS=0
# Public https:// address used in emailed links. Required in staging/production.
# GOVERNANCE_PUBLIC_URL=https://desk.example.com

# ---- Email -----------------------------------------------------------------------------------
# outbox (development default): messages are written to <data dir>/mail-outbox, nothing is sent.
# resend | smtp: real delivery (credentials below). disabled: messages are dropped (logged).
# staging/production must choose resend, smtp or disabled.
# GOVERNANCE_MAIL_PROVIDER=outbox
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true

# ---- Behaviour switches (unset = environment default) --------------------------------------
# GOVERNANCE_API_DOCS=        # /api/docs + /api/openapi.json; default on in development/test only
# GOVERNANCE_AUTO_MIGRATE=    # apply migrations on start; default on in development/test only
# GOVERNANCE_HSTS=            # Strict-Transport-Security; default on in staging/production
# GOVERNANCE_CSP=             # full Content-Security-Policy override; empty = built-in policy
# GOVERNANCE_REMINDERS_ENABLED=true
# GOVERNANCE_REMINDER_INTERVAL_SECONDS=60

# ---- Logging -------------------------------------------------------------------------------
# GOVERNANCE_LOG_LEVEL=INFO
# GOVERNANCE_LOG_FORMAT=json  # json (default) | text

# ---- Optional external services (empty = not configured). Secrets are masked in logs. --------
OPENAI_API_KEY=
OPENAI_MODEL=
RESEND_API_KEY=
MAIL_FROM=
